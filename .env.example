# Copy to .env.local (not committed) and fill in.

# Global, permanent leaderboard: an Upstash Redis database (free plan is plenty).
# upstash.com → Create Database (Redis) → REST API → copy the URL and the token.
# On Vercel, adding "Upstash for Redis" under Storage sets KV_REST_API_URL /
# KV_REST_API_TOKEN instead, which also work.
# Without these, the leaderboard is a local file (.data/leaderboard.json).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
